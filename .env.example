# Endereço do Kavox Connect e a chave de produto da conta, criada no painel em Chaves.
# kcx_test_… usa as integrações de sandbox; kcx_live_… as de produção. Nunca versione a chave.
KAVOX_CONNECT_URL=http://localhost:8290
KAVOX_CONNECT_KEY=

# Chave de gestão (kcx_mgmt_…), para as telas de Credenciais, Chaves e Reservas. Criada pelo dono da conta no painel.
KAVOX_CONNECT_MGMT_KEY=
# Num servidor exposto: a tela pede esta senha (qualquer usuário). Vazio = sem senha, só para a sua máquina.
KAVOX_SDK_PASSWORD=
